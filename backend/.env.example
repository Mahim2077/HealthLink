APP_NAME=HealthLink
APP_ENV=development
DEBUG=true
CRON_SECRET=

DATABASE_URL=
DB_DISABLE_PREPARED_STATEMENTS=false


JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Apply the email-code migration before enabling. Keep values in backend/.env
# for local testing or private backend environment variables on the host.
AUTH_EMAIL_OTP_ENABLED=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_EMAIL_OTP_SECRET=
AUTH_SMTP_HOST=smtp-relay.brevo.com
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_KEY=
AUTH_SMTP_FROM_EMAIL=

AI_ENABLED=false
# Backend-only provider/key. Use mock for offline development and CI.
AI_PROVIDER=groq
AI_API_KEY=
# Model replacements must support the selected provider's structured output.
AI_MODEL=qwen/qwen3.8-27b
AI_RECORD_CONTEXT_ENABLED=false
AI_TIMEOUT_SECONDS=20
AI_MAX_INPUT_CHARACTERS=12000
AI_MAX_CONTEXT_RECORDS=10

FRONTEND_URL=http://localhost:3000
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=HealthLink/0.1 (+https://healthlink-sd.vercel.app/)
